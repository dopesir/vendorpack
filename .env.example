# Server & App Config
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ==============================================================================
# AI / MULTIMODAL OCR PROVIDER ($0 FREE OPTIONS)
# Options: "gemini" | "groq" | "openrouter" | "heuristic"
# (Default: auto-detects based on available keys; falls back to "heuristic" if none)
# ==============================================================================
AI_PROVIDER="gemini"

# Option 1: Google Gemini 1.5/2.0 Flash (100% FREE at https://aistudio.google.com)
# 1,500 requests/day, 15 RPM, $0 cost, no credit card required.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# Option 2: Groq Cloud (Free tier at https://console.groq.com)
# Llama 3.2 11B Vision, 30 RPM, $0 cost.
GROQ_API_KEY=""
GROQ_MODEL="llama-3.2-11b-vision-preview"

# Option 3: OpenRouter Free Models (https://openrouter.ai)
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="meta-llama/llama-3.2-11b-vision-instruct:free"

# ==============================================================================
# DATABASE & STORAGE PROVIDER ($0 FREE OPTIONS)
# Options: "memory" | "supabase"
# (Default: "memory" — zero setup, zero cost, ephemeral privacy compliant)
# ==============================================================================
DATABASE_PROVIDER="memory"

# Option: Supabase Free Tier (500MB DB, 1GB Storage at https://supabase.com)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ==============================================================================
# PAYMENTS & CHECKOUT
# Options: "upi_qr" | "razorpay"
# ==============================================================================
PAYMENT_PROVIDER="upi_qr"
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Dynamic Pricing Configuration
NEXT_PUBLIC_PRICE_SINGLE="299"
NEXT_PUBLIC_PRICE_FIVE_PACK="799"
